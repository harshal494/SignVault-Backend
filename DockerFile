# Stage 1: Build phase inside an isolated container
FROM maven:3.9.6-eclipse-temurin-17 AS build
WORKDIR /app
COPY pom.xml .
COPY src ./src
RUN mvn clean package -DskipTests

# Stage 2: Runtime environment setup
FROM eclipse-temurin:17-jre-jammy
WORKDIR /app

# The fix: Grab whatever jar was compiled and copy it as signvault.jar
COPY --from=build /app/target/*.jar /app/signvault.jar

EXPOSE 8080

# Starts your service from your exact required name template
ENTRYPOINT ["java", "-jar", "/app/signvault.jar"]
