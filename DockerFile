# Stage 1: Build
FROM maven:3.9-eclipse-temurin-17 AS build
WORKDIR /app
COPY pom.xml .
COPY src ./src
RUN mvn clean package -DskipTests

# Stage 2: Runtime environment setup
FROM eclipse-temurin:17-jre-jammy
WORKDIR /app

# Copies the compiled file and names it exactly signvault.jar in the working folder
COPY --from=build /app/target/signvault-0.1.1.jar /app/signvault.jar

EXPOSE 8080

# Starts the service using the precise directory location reference
ENTRYPOINT ["java", "-jar", "/app/signvault.jar"]